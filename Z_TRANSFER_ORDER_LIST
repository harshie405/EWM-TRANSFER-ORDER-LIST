*----------------------------------------------------------------------*
*Development ID : ZDDE-00102590                                        *
*Functional Spec: ZFSE-00102589                                        *
*Description:  Class for EWM transfer order list.This method is        *
*              called through this interface ZEWM_SCWM_WO_PRINT        *
*              of form ZEWM_SCWM_WO_MULTIPLE                           *
*-----------------------------------------------------------------------
*Change Log:                                                           *
*----------------------------------------------------------------------*
* Who       Date           CR            Text                          *
* MITTAJH1 10-Oct-2025   1100276341   Initial Development              *
*----------------------------------------------------------------------*
  METHOD get_data.

    CONSTANTS: lc_sign   TYPE char1    VALUE 'I',
               lc_option TYPE char2    VALUE 'EQ',
               lc_repid  TYPE progname VALUE 'ZEWM_CL_OPS_TRANSFER_ORD',
               lc_const  TYPE zconst   VALUE 'PLANT/STORAGELOC'.

    DATA: lr_adrnr  TYPE RANGE OF adrc-addrnumber.

    CLEAR: es_source_addr,es_dest_addr.
*fetching plant and storage location from zconstants_ops
    SELECT repid,
           const,
           counter,
           value
           FROM zconstants_ops
           WHERE repid = @lc_repid
           AND const = @lc_const
           ORDER BY PRIMARY KEY
           INTO TABLE @DATA(lt_value).
*fetch source address number and destination address number
    SELECT  a~plant,
            a~addressid AS source_address,
            c~storagelocation AS lgort,
            c~addressid AS dest_address
        FROM i_plant AS a
        INNER JOIN @lt_value AS b ON a~plant = substring( b~value, 1, 4 )
        INNER JOIN i_storagelocationaddress AS c ON c~plant = a~plant
                                                 AND c~storagelocation = substring( b~value, 6, 4 )
       WHERE a~plant = substring( b~value, 1, 4 )
       ORDER BY a~plant
       INTO @DATA(ls_source)
       UP TO 1 ROWS.
    ENDSELECT.
    IF sy-subrc EQ 0 .
      APPEND VALUE #( sign   = lc_sign
                      option = lc_option
                      low    = ls_source-source_address ) TO lr_adrnr. "source address number
      APPEND VALUE #( sign   = lc_sign
                      option = lc_option
                      low    = ls_source-dest_address ) TO lr_adrnr. "dest address number
    ENDIF.
*fetch  address details
    IF lr_adrnr IS NOT INITIAL.
      SELECT a~addrnumber,
             a~name1,
             a~street,
             a~post_code1,
             a~city1,
             a~tel_number,
             b~smtp_addr
        FROM adrc AS a
        LEFT OUTER JOIN adr6 AS b ON a~addrnumber = b~addrnumber
        WHERE a~addrnumber IN @lr_adrnr
        INTO TABLE @DATA(lt_adrc).
      IF sy-subrc EQ 0.
        DATA(ls_sourceaddress) = VALUE #( lt_adrc[ addrnumber = ls_source-source_address ] OPTIONAL ).
        IF ls_sourceaddress IS NOT INITIAL.
          es_source_addr =  VALUE #( name       = ls_sourceaddress-name1
                                     city       = ls_sourceaddress-city1
                                     street     = ls_sourceaddress-street
                                     post_code1 = ls_sourceaddress-post_code1
                                     tel1_numbr = ls_sourceaddress-tel_number
                                     smtp_addr  = ls_sourceaddress-smtp_addr
                                ).
        ENDIF.
        DATA(ls_destaddress) = VALUE #( lt_adrc[ addrnumber = ls_source-dest_address ] OPTIONAL ).
        IF ls_destaddress IS NOT INITIAL.
          es_dest_addr =  VALUE #( name       = ls_destaddress-name1
                                   city       = ls_destaddress-city1
                                   street  = ls_destaddress-street
                                   post_code1 = ls_destaddress-post_code1
                               ).
        ENDIF.
      ENDIF.
    ENDIF.
  ENDMETHOD.

